# For local development, use a PostgreSQL database
# Install PostgreSQL locally or use a free service like Neon
DATABASE_URL="postgresql://user:password@localhost:5432/videonotes"
DIRECT_URL="postgresql://user:password@localhost:5432/videonotes"

# For Vercel deployment:
# 1. Go to your Vercel project dashboard
# 2. Click "Storage" tab
# 3. Create a Postgres database
# 4. It will automatically set DATABASE_URL and POSTGRES_PRISMA_URL
# 5. Copy POSTGRES_PRISMA_URL to DATABASE_URL
# 6. Copy POSTGRES_URL_NON_POOLING to DIRECT_URL
